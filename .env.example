# Copy this file to .env (same directory) and fill in your key.
#
# You need an Anthropic API key (see the README's "Getting an API key"
# section). API usage is paid, but the whole assessment costs only a few
# dollars of usage at most — and if getting a key is a barrier, tell your
# recruiter before you start.
ANTHROPIC_API_KEY=

# The assessment is calibrated on this model. Leave it as is.
STUDY_COACH_MODEL=anthropic:claude-sonnet-4-6
